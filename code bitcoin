# ============================================================
# Main
# ============================================================

def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--data-dir",
        default=str(DATA_DIR)
    )

    parser.add_argument(
        "--max-combo",
        type=int,
        default=MAX_COMBO
    )

    parser.add_argument(
        "--min-trades",
        type=int,
        default=MIN_TRADES
    )

    parser.add_argument(
        "--train-end",
        default=TRAIN_END
    )

    args = parser.parse_args()

    global DATA_DIR
    global MIN_TRADES
    global TRAIN_END

    DATA_DIR = Path(
        args.data_dir
    )

    MIN_TRADES = args.min_trades

    TRAIN_END = args.train_end

    print()
    print("=" * 90)
    print("ROBUST CRYPTO PATTERN BACKTESTER")
    print("=" * 90)

    print(
        f"Data directory : {DATA_DIR}"
    )

    print(
        f"Round-trip fee : "
        f"{ROUND_TRIP_FEE * 100:.2f}%"
    )

    print(
        f"Train end      : {TRAIN_END}"
    )

    print(
        f"Min trades     : {MIN_TRADES}"
    )

    # --------------------------------------------------------
    # 데이터 탐색
    # --------------------------------------------------------

    files = discover_data_files()

    if not files:
        raise FileNotFoundError(
            "data/ 아래에서 "
            "*_1d_all.csv.gz 또는 "
            "*_4h_all.csv.gz 파일을 "
            "찾지 못했습니다."
        )

    print()
    print(
        f"발견된 데이터: "
        f"{len(files)}개"
    )

    for f in files:
        symbol, interval = parse_file_info(f)

        print(
            f"  - {symbol:15s} "
            f"{interval:3s} "
            f"{f.name}"
        )

    # --------------------------------------------------------
    # 전체 데이터 실행
    # --------------------------------------------------------

    all_results = []

    for path in files:

        rows = process_file(
            path,
            max_combo=args.max_combo
        )

        all_results.extend(rows)

    # --------------------------------------------------------
    # 결과
    # --------------------------------------------------------

    if not all_results:

        print()
        print(
            "유효한 백테스트 결과가 없습니다."
        )

        return

    results = pd.DataFrame(
        all_results
    )

    results = rank_results(
        results
    )

    all_path, qualified_path = (
        save_results(results)
    )

    print_summary(
        results
    )

    print()
    print("=" * 90)
    print("파일 저장 완료")
    print("=" * 90)

    print(
        f"전체 결과 : {all_path}"
    )

    print(
        f"통과 결과 : {qualified_path}"
    )

    print()
    print(
        "백테스트 종료."
    )


if __name__ == "__main__":
    main()