def discover_data_files() -> list[Path]:
    """
    data/ 아래의 암호화폐 OHLCV 파일 자동 탐색.
    예:
        BTCUSDT_1d_all.csv.gz
        ETHUSDT_4h_all.csv.gz
    """

    if not DATA_DIR.exists():
        raise FileNotFoundError(f"데이터 폴더가 없습니다: {DATA_DIR}")

    patterns = [
        "*_1d_all.csv.gz",
        "*_4h_all.csv.gz",
        "*_1D_all.csv.gz",
        "*_4H_all.csv.gz",
        "*_1d.csv.gz",
        "*_4h.csv.gz",
        "*_1D.csv.gz",
        "*_4H.csv.gz",
    ]

    files = set()

    for pattern in patterns:
        files.update(DATA_DIR.glob(pattern))

    return sorted(files)


def parse_file_info(path: Path):
    """
    파일명에서 symbol / interval 추출.
    """

    name = path.name.lower()

    if "_1d" in name:
        interval = "1d"
    elif "_4h" in name:
        interval = "4h"
    else:
        interval = "unknown"

    stem = path.name

    m = re.match(r"(.+?)_(?:1d|4h|1D|4H)(?:_all)?\.csv\.gz$", stem)

    if m:
        symbol = m.group(1).upper()
    else:
        symbol = path.stem.replace(".csv", "").upper()

    return symbol, interval


