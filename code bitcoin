def define_signals(df: pd.DataFrame) -> pd.DataFrame:

    s = pd.DataFrame(index=df.index)

    c = df["close"]

    # --------------------------------------------------------
    # RSI
    # --------------------------------------------------------

    s["RSI14<30"] = df["rsi14"] < 30

    s["RSI14<35"] = df["rsi14"] < 35

    s["RSI7<25"] = df["rsi7"] < 25

    s["RSI21<30"] = df["rsi21"] < 30

    s["RSI14_rebound"] = (
        (df["rsi14"] > 30) &
        (df["rsi14"].shift(1) <= 30)
    )

    # --------------------------------------------------------
    # MACD
    # --------------------------------------------------------

    s["MACD_cross_up"] = (
        (df["macd"] > df["macd_signal"]) &
        (df["macd"].shift(1) <= df["macd_signal"].shift(1))
    )

    s["MACD_hist_positive"] = (
        df["macd_hist"] > 0
    )

    s["MACD_hist_rising"] = (
        df["macd_hist"] >
        df["macd_hist"].shift(1)
    )

    # --------------------------------------------------------
    # Moving average
    # --------------------------------------------------------

    s["price_above_SMA50"] = (
        c > df["sma50"]
    )

    s["price_above_SMA200"] = (
        c > df["sma200"]
    )

    s["EMA20_above_EMA50"] = (
        df["ema20"] >
        df["ema50"]
    )

    s["EMA7_cross_EMA20"] = (
        (df["ema7"] > df["ema20"]) &
        (df["ema7"].shift(1) <= df["ema20"].shift(1))
    )

    s["SMA50_cross_SMA200"] = (
        (df["sma50"] > df["sma200"]) &
        (df["sma50"].shift(1) <= df["sma200"].shift(1))
    )

    # --------------------------------------------------------
    # Bollinger
    # --------------------------------------------------------

    s["BB_below_lower"] = (
        c < df["bb_lower"]
    )

    s["BB_pctb<0.2"] = (
        df["bb_pctb"] < 0.2
    )

    s["BB_reclaim_0.2"] = (
        (df["bb_pctb"] > 0.2) &
        (df["bb_pctb"].shift(1) <= 0.2)
    )

    # --------------------------------------------------------
    # Stochastic
    # --------------------------------------------------------

    s["STOCH<20"] = (
        df["stoch_k"] < 20
    )

    s["STOCH_cross_up"] = (
        (df["stoch_k"] > df["stoch_d"]) &
        (df["stoch_k"].shift(1) <= df["stoch_d"].shift(1))
    )

    # --------------------------------------------------------
    # ADX
    # --------------------------------------------------------

    s["ADX>25"] = (
        df["adx14"] > 25
    )

    s["PLUS_DI>MINUS_DI"] = (
        df["plus_di14"] >
        df["minus_di14"]
    )

    # --------------------------------------------------------
    # Volume
    # --------------------------------------------------------

    s["Volume>1.5x"] = (
        df["volume_ratio"] > 1.5
    )

    s["Volume>2x"] = (
        df["volume_ratio"] > 2
    )

    # --------------------------------------------------------
    # Momentum
    # --------------------------------------------------------

    s["Return3_positive"] = (
        df["return_3"] > 0
    )

    s["Return5_positive"] = (
        df["return_5"] > 0
    )

    return s.fillna(False)


# ============================================================
# Wilson confidence interval
# ============================================================

def wilson_interval(
    wins: int,
    total: int,
    confidence: float = 0.95
):

    if total <= 0:
        return np.nan, np.nan

    # 95% CI z
    z = 1.959963984540054

    p = wins / total

    denominator = 1 + z**2 / total

    center = (
        p +
        z**2 / (2 * total)
    ) / denominator

    margin = (
        z *
        math.sqrt(
            (
                p * (1 - p) / total
            ) +
            (
                z**2 /
                (4 * total**2)
            )
        )
    ) / denominator

    lower = max(0.0, center - margin)
    upper = min(1.0, center + margin)

    return lower, upper


# ============================================================
# Trade simulation
# ============================================================

def simulate_trade(
    df: pd.DataFrame,
    signal_index: int,
    tp: float,
    sl: float,
    hold_days: int,
):

    entry_index = signal_index + 1

    if entry_index >= len(df):
        return None

    entry_time = df.iloc[entry_index]["date"]

    entry_price = float(
        df.iloc[entry_index]["open"]
    )

    if not np.isfinite(entry_price) or entry_price <= 0:
        return None

    tp_price = (
        entry_price *
        (1 + tp)
    )

    sl_price = (
        entry_price *
        (1 - sl)
    )

    last_index = min(
        entry_index + hold_days,
        len(df) - 1
    )

    exit_index = last_index
    exit_price = float(
        df.iloc[last_index]["close"]
    )

    exit_reason = "TIME"

    # --------------------------------------------------------
    # 미래 봉 탐색
    # --------------------------------------------------------

    for i in range(
        entry_index,
        last_index + 1
    ):

        high = float(df.iloc[i]["high"])
        low = float(df.iloc[i]["low"])

        # 중요:
        # 같은 봉에서 TP와 SL이 동시에 닿으면
        # SL 우선 처리
        if low <= sl_price:
            exit_index = i
            exit_price = sl_price
            exit_reason = "SL"
            break

        if high >= tp_price:
            exit_index = i
            exit_price = tp_price
            exit_reason = "TP"
            break

    gross_return = (
        exit_price /
        entry_price
    ) - 1

    # 왕복 비용 0.2%
    net_return = (
        (1 + gross_return) *
        (1 - ROUND_TRIP_FEE)
    ) - 1

    win = net_return > 0

    return Trade(
        entry_time=entry_time,
        exit_time=df.iloc[exit_index]["date"],
        entry_price=entry_price,
        exit_price=exit_price,
        gross_return=gross_return,
        net_return=net_return,
        win=win,
        exit_reason=exit_reason,
    )


# ============================================================
# Metrics
# ============================================================

def calculate_metrics(
    trades: list[Trade]
):

    if not trades:
        return {}

    returns = np.array(
        [t.net_return for t in trades],
        dtype=float
    )

    wins = returns > 0

    n = len(returns)

    win_count = int(wins.sum())

    win_rate = (
        win_count / n
    )

    wi_low, wi_high = wilson_interval(
        win_count,
        n
    )

    # --------------------------------------------------------
    # Expectancy
    # --------------------------------------------------------

    expectancy = float(
        np.mean(returns)
    )

    # --------------------------------------------------------
    # Profit factor
    # --------------------------------------------------------

    gross_profit = returns[returns > 0].sum()

    gross_loss = -returns[returns < 0].sum()

    if gross_loss > 0:
        profit_factor = (
            gross_profit /
            gross_loss
        )
    else:
        profit_factor = np.inf

    # --------------------------------------------------------
    # Equity / MDD
    # --------------------------------------------------------

    equity = np.cumprod(
        1 + returns
    )

    peak = np.maximum.accumulate(
        equity
    )

    drawdown = (
        equity / peak
    ) - 1

    max_drawdown = float(
        drawdown.min()
    )

    total_return = (
        equity[-1] - 1
    )

    avg_win = (
        returns[returns > 0].mean()
        if np.any(returns > 0)
        else 0
    )

    avg_loss = (
        returns[returns < 0].mean()
        if np.any(returns < 0)
        else 0
    )

    return {
        "trades": n,
        "wins": win_count,
        "win_rate": win_rate,
        "wilson95_low": wi_low,
        "wilson95_high": wi_high,
        "expectancy": expectancy,
        "profit_factor": profit_factor,
        "avg_win": avg_win,
        "avg_loss": avg_loss,
        "total_return": total_return,
        "max_drawdown": max_drawdown,
        "tp_count": sum(
            t.exit_reason == "TP"
            for t in trades
        ),
        "sl_count": sum(
            t.exit_reason == "SL"
            for t in trades
        ),
        "time_count": sum(
            t.exit_reason == "TIME"
            for t in trades
        ),
    }


# ============================================================
# Backtest one signal
# ============================================================

def run_signal_backtest(
    df: pd.DataFrame,
    signal: pd.Series,
    tp: float,
    sl: float,
    hold_days: int,
):

    signal_indices = np.where(
        signal.values
    )[0]

    trades = []

    # 포지션 중복 방지
    next_available_index = -1

    for idx in signal_indices:

        if idx < next_available_index:
            continue

        trade = simulate_trade(
            df=df,
            signal_index=int(idx),
            tp=tp,
            sl=sl,
            hold_days=hold_days,
        )

        if trade is None:
            continue

        trades.append(trade)

        # 진입 이후 종료까지 새로운 포지션 금지
        exit_positions = df.index[
            df["date"] == trade.exit_time
        ]

        if len(exit_positions):
            next_available_index = (
                int(exit_positions[0]) + 1
            )

    return trades


# ============================================================
# Train / OOS split
# ============================================================

def split_trades(
    trades: list[Trade],
    train_end: str
):

    train_end_ts = pd.Timestamp(
        train_end,
        tz="UTC"
    )

    train = [
        t for t in trades
        if t.entry_time <= train_end_ts
    ]

    oos = [
        t for t in trades
        if t.entry_time > train_end_ts
    ]

    return train, oos


# ============================================================
# Parameter stability
# ============================================================

def stability_test(
    df: pd.DataFrame,
    signal: pd.Series,
    best_tp: float,
    best_sl: float,
    best_hold: int,
):

    # 중심값 주변의 파라미터를 테스트
    tp_candidates = sorted(set([
        max(0.005, best_tp - 0.005),
        best_tp,
        best_tp + 0.005,
    ]))

    sl_candidates = sorted(set([
        max(0.005, best_sl - 0.005),
        best_sl,
        best_sl + 0.005,
    ]))

    hold_candidates = sorted(set([
        max(1, best_hold - 2),
        best_hold,
        best_hold + 2,
    ]))

    rows = []

    for tp, sl, hold in itertools.product(
        tp_candidates,
        sl_candidates,
        hold_candidates
    ):

        trades = run_signal_backtest(
            df,
            signal,
            tp,
            sl,
            hold
        )

        if len(trades) < MIN_TRADES:
            continue

        _, oos = split_trades(
            trades,
            TRAIN_END
        )

        if len(oos) < MIN_OOS_TRADES:
            continue

        m = calculate_metrics(oos)

        rows.append({
            "tp": tp,
            "sl": sl,
            "hold": hold,
            "oos_trades": m["trades"],
            "oos_win_rate": m["win_rate"],
            "oos_expectancy": m["expectancy"],
            "oos_pf": m["profit_factor"],
        })

    if not rows:
        return {
            "stable": False,
            "stability_pass_count": 0,
            "stability_total_count": 0,
        }

    stable_count = sum(
        r["oos_win_rate"] >=
        STABILITY_MIN_OOS_WIN_RATE
        for r in rows
    )

    stable_ratio = (
        stable_count /
        len(rows)
    )

    return {
        "stable": stable_ratio >= 0.50,
        "stability_pass_count": stable_count,
        "stability_total_count": len(rows),
        "stability_ratio": stable_ratio,
    }


