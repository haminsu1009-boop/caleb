def evaluate_combination(
    df: pd.DataFrame,
    signal_df: pd.DataFrame,
    combo: tuple[str, ...],
    symbol: str,
    interval: str,
):

    combined = (
        signal_df[list(combo)]
        .all(axis=1)
    )

    all_rows = []

    for tp, sl, hold in itertools.product(
        TP_LIST,
        SL_LIST,
        HOLD_LIST
    ):

        trades = run_signal_backtest(
            df,
            combined,
            tp,
            sl,
            hold
        )

        if len(trades) < MIN_TRADES:
            continue

        train, oos = split_trades(
            trades,
            TRAIN_END
        )

        if len(train) < MIN_TRADES:
            continue

        if len(oos) < MIN_OOS_TRADES:
            continue

        train_m = calculate_metrics(
            train
        )

        oos_m = calculate_metrics(
            oos
        )

        # ----------------------------------------------------
        # OOS 승률이 50% 미만이면 일단 제외
        # ----------------------------------------------------

        if oos_m["win_rate"] < 0.50:
            continue

        # ----------------------------------------------------
        # 파라미터 안정성
        # ----------------------------------------------------

        stability = stability_test(
            df,
            combined,
            tp,
            sl,
            hold
        )

        row = {
            "symbol": symbol,
            "interval": interval,
            "pattern": " + ".join(combo),
            "signal_count": len(combo),

            "tp": tp,
            "sl": sl,
            "hold_days": hold,

            # Train
            "train_trades": train_m["trades"],
            "train_win_rate": train_m["win_rate"],
            "train_wilson_low": train_m["wilson95_low"],
            "train_wilson_high": train_m["wilson95_high"],
            "train_expectancy": train_m["expectancy"],
            "train_profit_factor": train_m["profit_factor"],
            "train_total_return": train_m["total_return"],
            "train_mdd": train_m["max_drawdown"],

            # OOS
            "oos_trades": oos_m["trades"],
            "oos_win_rate": oos_m["win_rate"],
            "oos_wilson_low": oos_m["wilson95_low"],
            "oos_wilson_high": oos_m["wilson95_high"],
            "oos_expectancy": oos_m["expectancy"],
            "oos_profit_factor": oos_m["profit_factor"],
            "oos_total_return": oos_m["total_return"],
            "oos_mdd": oos_m["max_drawdown"],

            # Exit
            "oos_tp_count": oos_m["tp_count"],
            "oos_sl_count": oos_m["sl_count"],
            "oos_time_count": oos_m["time_count"],

            # Stability
            **stability,
        }

        # ----------------------------------------------------
        # 핵심 최종 필터
        # ----------------------------------------------------

        row["qualified"] = (
            row["oos_trades"] >= MIN_OOS_TRADES
            and
            row["oos_win_rate"] >= 0.70
            and
            row["oos_wilson_low"] >= 0.50
            and
            row["oos_expectancy"] > 0
            and
            row["oos_profit_factor"] > 1.20
            and
            row["stable"]
        )

        all_rows.append(row)

    return all_rows


# ============================================================
# Process one file
# ============================================================

def process_file(
    path: Path,
    max_combo: int = MAX_COMBO
):

    symbol, interval = parse_file_info(
        path
    )

    print()
    print("=" * 70)
    print(
        f"[{symbol} / {interval}]"
    )
    print("=" * 70)

    try:
        df = load_data(path)

    except Exception as e:
        print(
            f"  ERROR loading: {e}"
        )
        return []

    print(
        f"  rows={len(df):,}"
    )

    print(
        f"  period="
        f"{df['date'].min()} ~ "
        f"{df['date'].max()}"
    )

    # --------------------------------------------------------
    # Indicators
    # --------------------------------------------------------

    df = add_indicators(df)

    # --------------------------------------------------------
    # Signals
    # --------------------------------------------------------

    signals = define_signals(df)

    signal_cols = list(
        signals.columns
    )

    print(
        f"  signals={len(signal_cols)}"
    )

    results = []

    # --------------------------------------------------------
    # 단일 신호
    # --------------------------------------------------------

    for combo_size in range(
        1,
        max_combo + 1
    ):

        combos = itertools.combinations(
            signal_cols,
            combo_size
        )

        for n, combo in enumerate(
            combos,
            start=1
        ):

            rows = evaluate_combination(
                df,
                signals,
                combo,
                symbol,
                interval
            )

            results.extend(rows)

            if n % 50 == 0:
                print(
                    f"    combo size "
                    f"{combo_size}: "
                    f"{n} tested"
                )

    print(
        f"  valid results="
        f"{len(results):,}"
    )

    return results


# ============================================================
# Ranking
# ============================================================

def rank_results(
    df: pd.DataFrame
) -> pd.DataFrame:

    if df.empty:
        return df

    # OOS 중심 점수
    #
    # 승률 자체만 높으면 과최적화 가능성이 있음.
    # Wilson 하한과 PF, 거래횟수를 함께 반영한다.

    df = df.copy()

    df["score"] = (
        df["oos_wilson_low"] * 0.40
        +
        np.minimum(
            df["oos_profit_factor"],
            5
        ) / 5 * 0.25
        +
        np.clip(
            df["oos_expectancy"] * 20,
            -1,
            1
        ) * 0.15
        +
        df["stability_ratio"].fillna(0)
        * 0.20
    )

    df = df.sort_values(
        [
            "qualified",
            "score",
            "oos_win_rate",
            "oos_wilson_low",
            "oos_profit_factor",
            "oos_trades",
        ],
        ascending=[
            False,
            False,
            False,
            False,
            False,
            False,
        ],
    ).reset_index(drop=True)

    return df


# ============================================================
# Save
# ============================================================

def save_results(
    results: pd.DataFrame
):

    OUTPUT_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    all_path = (
        OUTPUT_DIR /
        "robust_results_all.csv"
    )

    qualified_path = (
        OUTPUT_DIR /
        "robust_results_qualified.csv"
    )

    results.to_csv(
        all_path,
        index=False,
        encoding="utf-8-sig"
    )

    qualified = results[
        results["qualified"] == True
    ].copy()

    qualified.to_csv(
        qualified_path,
        index=False,
        encoding="utf-8-sig"
    )

    return all_path, qualified_path


