# Stock Bot 환경변수 설정
# cp .env.example .env → 실제 키 입력

# ────────────────────────────────────────────────
# ① Google Gemini (필수 · 무료)
# aistudio.google.com → Get API key
# ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ────────────────────────────────────────────────
# ② 텔레그램 알림 (추천 · 무료)
# 설정법:
#   1. 텔레그램 앱 → @BotFather 검색 → /newbot → 이름 입력
#   2. 받은 TOKEN을 아래에 입력
#   3. 본인 봇에게 아무 메시지 전송
#   4. https://api.telegram.org/bot{TOKEN}/getUpdates 에서 chat_id 확인
# ────────────────────────────────────────────────
TELEGRAM_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff
TELEGRAM_CHAT_ID=123456789

# ────────────────────────────────────────────────
# ③ Alpaca 미국 주식 자동매매 (선택 · 페이퍼 무료)
# alpaca.markets 가입 → Paper Trading → API Keys
# ────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true           # true=페이퍼(모의), false=실거래

# ────────────────────────────────────────────────
# ④ IBKR 선물 자동매매 (선택 · TWS 실행 필요)
# TWS 또는 IB Gateway를 먼저 실행해야 함
# Port: 7497=페이퍼, 7496=실거래
# ────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_PAPER=true

# ────────────────────────────────────────────────
# ⑤ 한국투자증권 KIS (한국 주식 실거래 시 필요)
# apiportal.koreainvestment.com
# ────────────────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_SUFFIX=01
