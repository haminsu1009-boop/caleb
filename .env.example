# ────────────────────────────────────────
# 퀀트 트레이딩 봇 — 환경변수 설정 파일
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요
# cp .env.example .env
# ────────────────────────────────────────

# ── Binance API ──────────────────────────
# https://www.binance.com → 보안 → API 관리 → API 키 생성
# 권한: "읽기" + "현물 및 마진 거래" 체크 (출금은 절대 X)
BINANCE_API_KEY=여기에_API_키_붙여넣기
BINANCE_SECRET_KEY=여기에_시크릿_키_붙여넣기

# 테스트넷 사용 여부 (True = 가짜돈, False = 실돈)
# 처음엔 반드시 True로 시작!
BINANCE_TESTNET=True

# ── 텔레그램 알림 ────────────────────────
# 1. 텔레그램에서 @BotFather 검색
# 2. /newbot → 이름 입력 → 토큰 받기
# 3. @userinfobot 에서 내 chat_id 확인
TELEGRAM_TOKEN=여기에_봇_토큰_붙여넣기
TELEGRAM_CHAT_ID=여기에_채팅_ID_붙여넣기

# ── 리스크 설정 ──────────────────────────
# 전체 자본 대비 한 거래에 투자할 비율 (0.1 = 10%)
POSITION_SIZE_RATIO=0.10

# 손절 비율 (0.05 = -5% 되면 자동 손절)
STOP_LOSS_PCT=0.05

# 익절 비율 (0.10 = +10% 되면 자동 익절)
TAKE_PROFIT_PCT=0.10

# 최대 동시 포지션 수
MAX_POSITIONS=3

# 일일 최대 손실 한도 (초과 시 당일 거래 중단)
DAILY_LOSS_LIMIT=0.03

# ── 거래 대상 코인 ───────────────────────
# 쉼표로 구분 (USDT 마켓)
COINS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT

# ── 신호 설정 ────────────────────────────
# ML 매수 확률 임계값 (높을수록 신호 드물고 정확)
SIGNAL_THRESHOLD=0.65
