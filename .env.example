# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Bybit API 설정
# 이 파일을 .env 로 복사하고 실제 값을 입력하세요
# cp .env.example .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BYBIT_API_KEY=여기에_API_KEY_입력
BYBIT_SECRET=여기에_SECRET_KEY_입력

# 거래 설정
BYBIT_TESTNET=false          # 실거래: false / 테스트넷: true
TRADING_SYMBOL=BTCUSDT       # 거래 종목
TRADING_LEVERAGE=1           # 레버리지 (1=무레버리지, 최대 100)
TRADE_USDT=10                # 건당 투자금액 (USDT)
CANDLE_INTERVAL=5            # 분봉 단위 (1/3/5/15/30/60)
