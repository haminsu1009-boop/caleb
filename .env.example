# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore에 등록돼 있다.
# ⚠️ 키를 채팅·이슈·커밋 어디에도 붙여넣지 말 것.
#
# 바이빗에서 키 생성 시:
#   · 출금(Withdraw) 권한 반드시 해제
#   · 필요한 권한은 Contract - Orders, Positions 와 Wallet 조회뿐
#   · 가능하면 접속 IP 화이트리스트 설정
#   · 계정을 격리마진(Isolated)으로 설정 — 한 포지션이 터져도 계좌 전체가 남는다

BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── 전략 파라미터 (백테스트 최적값) ──────────────────────────────
# 전체구간 2017~2026 기준: 2배 = 36.8배(연복리 51%, 최대낙폭 47%, 청산 0회)
#                          3배 = 109배지만 최대낙폭 76% — 실제로 못 버틴다
OS_LEVERAGE=2
OS_PER_TRADE=0.15          # 진입당 자본 비율
OS_MAX_GROSS=1.0           # 총 노출 상한 (자본 대비 배수, 레버리지 곱하기 전)
#
# 동시 보유 종목수 = MAX_GROSS / PER_TRADE. 낙폭의 주된 원인은 급락 시
# 12종목이 한꺼번에 물리는 것이므로 이 값이 실질적인 위험 조절 손잡이다.
# 숏 병행과 200일선 필터는 둘 다 효과가 없었다(ml/long_short.py,
# ml/drawdown_fix.py). 배율보다 이쪽을 먼저 조절해라.
#
#   동시  진입당  총노출 |  전체 2017~26      |  홀드아웃 2024~26
#     2    25%    50%  |  37.7배  낙폭 28.3% |  1.6배  낙폭  9.8%   ← 방어적
#     4    20%    80%  |  30.3배  낙폭 49.6% |  2.6배  낙폭  8.9%
#     6    15%   100%  |  34.8배  낙폭 48.6% |  3.1배  낙폭 11.9%   ← 기본값
#     8  12.5%   100%  |  34.3배  낙폭 48.2% |  3.5배  낙폭 10.0%   ← 공격적
#
# 전체구간 낙폭이 낮은 설정일수록 홀드아웃 수익이 낮다. 2018·2020·2022
# 같은 폭락이 다시 온다고 보면 위쪽, 안 온다고 보면 아래쪽이다.

# ── 안전장치 ────────────────────────────────────────────────
OS_DAILY_LOSS=0.05         # 하루 손실 5% 넘으면 신규 진입 중단
OS_MAX_DRAWDOWN=0.25       # 고점 대비 25% 하락 시 전량 청산 후 완전 정지
OS_MIN_EQUITY=50           # 자본이 이 아래면 진입 중단 (USDT)
OS_POLL_SECONDS=300        # 점검 주기

# 모의 실행 시 가정할 자본
OS_PAPER_EQUITY=1000
