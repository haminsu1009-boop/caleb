# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore에 등록돼 있다.
# ⚠️ 키를 채팅·이슈·커밋 어디에도 붙여넣지 말 것.
#
# 바이빗에서 키 생성 시:
#   · 출금(Withdraw) 권한 반드시 해제
#   · 필요한 권한은 Contract - Orders, Positions 와 Wallet 조회뿐
#   · 가능하면 접속 IP 화이트리스트 설정
#   · 계정을 격리마진(Isolated)으로 설정 — 한 포지션이 터져도 계좌 전체가 남는다

BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── 전략 파라미터 (백테스트 최적값) ──────────────────────────────
# 아래 표는 ml/sim_correct.py 기준(자본 = 현금 + 평가손익, 강제청산은
# 봉 안 저가로 판정)이다. 이전 버전(full_optimizer.py)은 진입 시점에
# 미실현 이익을 복리로 반영하는 버그가 있어 46종·2배가 8.8년에 317배로
# 나왔는데, 그건 틀린 값이었다 — 고친 뒤에는 같은 설정이 훨씬 작다.
# 이 파일의 수치는 전부 고친 뒤(+ 분할매수 반영) 것이다.
#
# 46종, 20봉 보유, 분할매수(1차 30% 즉시 + 1차가 대비 -5% 더 빠지면
# 2차 70% 추가), 8.8년(2017~2026), 차단기 없음:
#
#   배율   동시   최종     연복리   낙폭(계좌)   낙폭(장중)
#    1x    20종   4.8배     20%      31.5%        53.1%
#    2x    20종   5.8배     22%      77.8%        92.9%   ← 기본값이지만 낙폭이 크다
#
# 일괄매수(분할 없음) 대비: 1x 2.4배→4.8배, 낙폭 37.3%→31.5% —
# 분할매수는 수익과 낙폭이 같이 좋아진 유일한 변경이다(ml/scale_in_portfolio.py).
# 2차가 안 걸리는 신호는 자본의 30%만 투입된 채 끝나므로 분할이
# 자동 사이징 역할도 한다.
OS_LEVERAGE=2
# per_trade는 한 거래의 "전체" 물량 비율이다(1차+2차 합산). 1차는
# 이 중 30%만 즉시 나간다(strategy.SCALE_IN_FIRST_FRAC). 0.05 = 최대
# 20건 동시 보유.
OS_PER_TRADE=0.05
OS_MAX_GROSS=1.0           # 총 노출 상한 (자본 대비 배수, 레버리지 곱하기 전)
#
# 동시 보유 건수 = MAX_GROSS / PER_TRADE. 낙폭의 주된 원인은 급락 시
# 여러 종목이 한꺼번에 물리는 것이므로 이 값이 실질적인 위험 조절
# 손잡이다 — 배율보다 먼저 이쪽을 조절해라. 숏 병행과 200일선 필터는
# 둘 다 효과가 없었다(ml/long_short.py, ml/drawdown_fix.py).
#
# 2배는 낙폭이 크다(장중 92.9%). 안전하게 시작하려면 우선 1배로
# 돌리고(연복리 20%, 낙폭 53.1%), 실거래 검증(로드맵 2단계)이 끝난
# 뒤에 올려라.

# ── 안전장치 ────────────────────────────────────────────────
OS_DAILY_LOSS=0.05         # 하루 손실 5% 넘으면 신규 진입 중단
OS_MAX_DRAWDOWN=0.25       # 고점 대비 25% 하락 시 신규 진입 중단
OS_HALT_COOLDOWN_DAYS=30  # 그 뒤 이 기간이 지나면 자동 재개
#
# 백테스트(ml/sim_correct.py, ml/path_to_100x.py)와 같은 모양이다 —
# 트리거되면 보유 포지션은 강제청산하지 않고 시간청산으로 정리되며,
# 신규 진입만 30일 막힌다. 영구 정지가 아니다. 이 차단기가 -25%에서
# 30일 재개로 있을 때 낙폭이 74.9%→28.6%로 줄면서도 100배 도달
# 기간은 그대로였다(즉 공짜로 낙폭만 줄었다) — 재개가 없으면 한 번
# 걸리고 다시는 안 도는 봇이 되어 이 효과가 안 나온다.
OS_MIN_EQUITY=50           # 자본이 이 아래면 진입 중단 (USDT)
OS_POLL_SECONDS=300        # 점검 주기

# 모의 실행 시 가정할 자본
OS_PAPER_EQUITY=1000

# ── 선박 추적 봇 (vessel/) ──────────────────────────────────
# AIS_PROVIDER를 비워두면 아래 키 중 등록된 쪽을 자동으로 쓰고,
# 둘 다 없으면 MockProvider(데모 데이터)로 동작한다.
AIS_PROVIDER=
VESSELFINDER_API_KEY=
MARINETRAFFIC_API_KEY=
AIS_CACHE_TTL_SEC=300      # 같은 선박 재조회 시 API 재호출 없이 캐시 사용(초)

# 텔레그램 선박 추적 봇 (vessel/telegram_bot.py)
# (coin/notifier.py도 TELEGRAM_TOKEN을 쓰지만 그건 매매 알림 전용 봇이라
#  같은 토큰을 공유하면 두 봇이 서로 메시지를 가로챌 수 있다 — 되도록
#  선박 추적용으로 새 봇을 하나 더 만들어 별도 토큰을 쓰길 권장한다)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# /update, /delete(터미널 정보 수동입력)를 쓸 수 있는 chat_id, 콤마구분.
# 비워두면 누구나 값을 바꿀 수 있음 — 운영 전 꼭 설정할 것.
TELEGRAM_ADMIN_IDS=

# 카카오톡 스킬 서버/웹위젯 서버 (vessel/server.py)
VESSEL_SERVER_PORT=8787
VESSEL_WIDGET_ORIGIN=*     # 배포 시 실제 사이트 도메인으로 제한 권장

# 항만 터미널 스케줄 조회 (vessel/terminal_providers.py) — 선사 스케줄보다
# 터미널 접안예정(ETB)이 실제 도착시간에 더 정확하다. 콤마구분 코드로
# 실제 쓰는 터미널만 좁힐 수 있다 (bpt,hjnc,pnit,hpnt,pnc). 비우면 전부 시도.
# ⚠️ 아직 각 터미널의 실제 조회 요청 형식이 미확인 상태라 자동조회는
#    안 되고, 봇 답장에 해당 터미널 링크만 보여준다. vessel/README.md 참고.
VESSEL_TERMINALS=

# 직원이 텔레그램 /update로 직접 입력한 터미널 정보가 유효한 시간(시간 단위).
# 지나면 자동으로 무시된다(갱신을 깜빡한 값을 최신인 것처럼 보여주지 않기 위함).
MANUAL_TERMINAL_TTL_HOURS=72
